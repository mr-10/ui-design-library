 "css": "/* Lovely Octopus 40 by benjimich — https://uiverse.io/benjimich/lovely-octopus-40 */\n.container {\n  display: flex;\n  position: relative;\n}\n\n.button {\n  cursor: pointer;\n  background: none;\n  border: none;\n  border-radius: 8px;\n  padding: .5em 1.5em;\n  font-size: 20px;\n  font-weight: 600;\n  color: #7f5af0;\n  transition: all .3s ease;\n}\n\n.arrow {\n  fill: #94a1b2;\n  position: absolute;\n  pointer-events: none;\n  width: 24px;\n  right: 0;\n  top: 25%;\n  transition: all .3s cubic-bezier(0.645, 0.045, 0.355, 1);\n}\n\n.button:hover {\n  letter-spacing: 2px;\n}\n\n.button:hover ~.second {\n  opacity: .66;\n  right: -20px;\n  transition-delay: 50ms;\n}\n\n.button:hover ~.third {\n  opacity: .33;\n  right: -40px;\n  transition-delay: 100ms;\n}\n\n.second,\n.third {\n  opacity: 0;\n}\n",
