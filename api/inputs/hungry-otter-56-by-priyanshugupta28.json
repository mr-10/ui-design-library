 "html": "<div class=\"rating\">\n  <input value=\"5\" name=\"rating\" id=\"star5\" type=\"radio\">\n  <label for=\"star5\"></label>\n  <input value=\"4\" name=\"rating\" id=\"star4\" type=\"radio\">\n  <label for=\"star4\"></label>\n  <input value=\"3\" name=\"rating\" id=\"star3\" type=\"radio\">\n  <label for=\"star3\"></label>\n  <input value=\"2\" name=\"rating\" id=\"star2\" type=\"radio\">\n  <label for=\"star2\"></label>\n  <input value=\"1\" name=\"rating\" id=\"star1\" type=\"radio\">\n  <label for=\"star1\"></label>\n</div>\n",
 "css": "/* Hungry Otter 56 by PriyanshuGupta28 — https://uiverse.io/PriyanshuGupta28/hungry-otter-56 */\n.rating {\n  display: flex;\n  flex-direction: row-reverse;\n\n  font-size: 0;\n\n}\n\n.rating input[type=\"radio\"] {\n  display: none;\n\n}\n\n.rating label {\n  font-size: 30px;\n  color: rgba(187, 183, 183, 0.726);\n\n  margin: 0 2px;\n  cursor: pointer;\n}\n\n.rating label:before {\n  content: \"\\2605\";\n\n}\n\n.rating input[type=\"radio\"]:checked ~ label:before {\n  content: \"\\2606\";\n\n  color: #016bf5;\n\n}\n",
 "combined": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Hungry Otter 56</title>\n<style>\n/* Hungry Otter 56 by PriyanshuGupta28 — https://uiverse.io/PriyanshuGupta28/hungry-otter-56 */\n.rating {\n  display: flex;\n  flex-direction: row-reverse;\n\n  font-size: 0;\n\n}\n\n.rating input[type=\"radio\"] {\n  display: none;\n\n}\n\n.rating label {\n  font-size: 30px;\n  color: rgba(187, 183, 183, 0.726);\n\n  margin: 0 2px;\n  cursor: pointer;\n}\n\n.rating label:before {\n  content: \"\\2605\";\n\n}\n\n.rating input[type=\"radio\"]:checked ~ label:before {\n  content: \"\\2606\";\n\n  color: #016bf5;\n\n}\n</style>\n</head>\n<body>\n<div class=\"rating\">\n  <input value=\"5\" name=\"rating\" id=\"star5\" type=\"radio\">\n  <label for=\"star5\"></label>\n  <input value=\"4\" name=\"rating\" id=\"star4\" type=\"radio\">\n  <label for=\"star4\"></label>\n  <input value=\"3\" name=\"rating\" id=\"star3\" type=\"radio\">\n  <label for=\"star3\"></label>\n  <input value=\"2\" name=\"rating\" id=\"star2\" type=\"radio\">\n  <label for=\"star2\"></label>\n  <input value=\"1\" name=\"rating\" id=\"star1\" type=\"radio\">\n  <label for=\"star1\"></label>\n</div>\n\n</body>\n</html>\n"
