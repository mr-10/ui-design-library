 "css": "/* Gentle Pig 32 by barisdogansutcu — https://uiverse.io/barisdogansutcu/gentle-pig-32 */\n.password {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 10px;\n}\n.password input {\n  width: 30px;\n  height: 40px;\n  text-align: center;\n  background-color: transparent;\n  border: none;\n  border-bottom: solid 2px rgb(20, 181, 230);\n  font-size: 20px;\n  color: white;\n  outline: none;\n}\n",
