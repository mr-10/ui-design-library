 "html": "<div class=\"form-control\">\n    <input type=\"value\" required=\"\">\n    <label>\n        <span style=\"transition-delay:0ms\">U</span><span style=\"transition-delay:50ms\">s</span><span style=\"transition-delay:100ms\">e</span><span style=\"transition-delay:150ms\">r</span><span style=\"transition-delay:200ms\">n</span><span style=\"transition-delay:250ms\">a</span><span style=\"transition-delay:300ms\">m</span><span style=\"transition-delay:350ms\">e</span>\n    </label>\n</div>",
 "css": "/* From Uiverse.io by liyaxu123 - Tags: input, animated */\n.form-control {\n  position: relative;\n  margin: 20px 0 40px;\n  width: 190px;\n}\n\n.form-control input {\n  background-color: transparent;\n  border: 0;\n  border-bottom: 2px #fff solid;\n  display: block;\n  width: 100%;\n  padding: 15px 0;\n  font-size: 18px;\n  color: #fff;\n}\n\n.form-control input:focus,\n.form-control input:valid {\n  outline: 0;\n  border-bottom-color: lightblue;\n}\n\n.form-control label {\n  position: absolute;\n  top: 15px;\n  left: 0;\n  pointer-events: none;\n}\n\n.form-control label span {\n  display: inline-block;\n  font-size: 18px;\n  min-width: 5px;\n  color: #fff;\n  transition: 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55);\n}\n\n.form-control input:focus+label span,\n.form-control input:valid+label span {\n  color: lightblue;\n  transform: translateY(-30px);\n}\n",
 "combined": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Warm Eel 62</title>\n<style>\n/* From Uiverse.io by liyaxu123 - https://uiverse.io/liyaxu123/warm-eel-62 */\n/* From Uiverse.io by liyaxu123 - Tags: input, animated */\n.form-control {\n  position: relative;\n  margin: 20px 0 40px;\n  width: 190px;\n}\n\n.form-control input {\n  background-color: transparent;\n  border: 0;\n  border-bottom: 2px #fff solid;\n  display: block;\n  width: 100%;\n  padding: 15px 0;\n  font-size: 18px;\n  color: #fff;\n}\n\n.form-control input:focus,\n.form-control input:valid {\n  outline: 0;\n  border-bottom-color: lightblue;\n}\n\n.form-control label {\n  position: absolute;\n  top: 15px;\n  left: 0;\n  pointer-events: none;\n}\n\n.form-control label span {\n  display: inline-block;\n  font-size: 18px;\n  min-width: 5px;\n  color: #fff;\n  transition: 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55);\n}\n\n.form-control input:focus+label span,\n.form-control input:valid+label span {\n  color: lightblue;\n  transform: translateY(-30px);\n}\n</style>\n</head>\n<body>\n<div class=\"form-control\">\n    <input type=\"value\" required=\"\">\n    <label>\n        <span style=\"transition-delay:0ms\">U</span><span style=\"transition-delay:50ms\">s</span><span style=\"transition-delay:100ms\">e</span><span style=\"transition-delay:150ms\">r</span><span style=\"transition-delay:200ms\">n</span><span style=\"transition-delay:250ms\">a</span><span style=\"transition-delay:300ms\">m</span><span style=\"transition-delay:350ms\">e</span>\n    </label>\n</div>\n</body>\n</html>\n"
}
