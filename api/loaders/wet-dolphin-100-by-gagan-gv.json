 "css": "/* Wet Dolphin 100 by gagan-gv — https://uiverse.io/gagan-gv/wet-dolphin-100 */\n.loader span {\n font-size: 22px;\n font-family: 'Courier New', Courier, monospace;\n font-weight: 600;\n animation: blur 3s linear infinite;\n line-height: 20px;\n transition: all 0.5s;\n letter-spacing: 0.2em;\n}\n\n@keyframes blur {\n 0%, 90% {\n  filter: blur(0);\n }\n\n 50% {\n  filter: blur(10px);\n }\n}\n",
 "combined": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Wet Dolphin 100</title>\n<style>\n/* Wet Dolphin 100 by gagan-gv — https://uiverse.io/gagan-gv/wet-dolphin-100 */\n.loader span {\n font-size: 22px;\n font-family: 'Courier New', Courier, monospace;\n font-weight: 600;\n animation: blur 3s linear infinite;\n line-height: 20px;\n transition: all 0.5s;\n letter-spacing: 0.2em;\n}\n\n@keyframes blur {\n 0%, 90% {\n  filter: blur(0);\n }\n\n 50% {\n  filter: blur(10px);\n }\n}\n</style>\n</head>\n<body>\n<div class=\"loader\">\n  <span>L</span>\n  <span>O</span>\n  <span>A</span>\n  <span>D</span>\n  <span>I</span>\n  <span>N</span>\n  <span>G</span>\n</div>\n\n</body>\n</html>\n"
