 "html": "<div class=\"loader\">\n    <span class=\"icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" version=\"1.1\" x=\"0\" y=\"0\" viewBox=\"0 0 100 100\">\n            <ellipse transform=\"rotate(-21.283 49.994 75.642)\" cx=\"50\" cy=\"75.651\" rx=\"19.347\" ry=\"16.432\" fill=\"currentColor\"></ellipse>\n            <path fill=\"currentColor\" d=\"M58.474 7.5h10.258v63.568H58.474z\"></path>\n        </svg>\n    </span>\n    <span class=\"icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" version=\"1.1\" x=\"0\" y=\"0\" viewBox=\"0 0 100 100\">\n            <ellipse transform=\"rotate(-21.283 49.994 75.642)\" cx=\"50\" cy=\"75.651\" rx=\"19.347\" ry=\"16.432\" fill=\"currentColor\"></ellipse>\n            <path fill=\"currentColor\" d=\"M58.474 7.5h10.258v63.568H58.474z\"></path>\n        </svg>\n    </span>\n    <span class=\"icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" version=\"1.1\" x=\"0\" y=\"0\" viewBox=\"0 0 100 100\">\n            <ellipse transform=\"rotate(-21.283 49.994 75.642)\" cx=\"50\" cy=\"75.651\" rx=\"19.347\" ry=\"16.432\" fill=\"currentColor\"></ellipse>\n            <path fill=\"currentColor\" d=\"M58.474 7.5h10.258v63.568H58.474z\"></path>\n        </svg>\n    </span>\n</div>",
 "css": "/* From Uiverse.io by DarrylNoakes - Tags: loader */\n.loader {\n  --icon-count: 3;\n  --inner-height: 4em;\n  --ratio: 2/3;\n /* Customizable */\n  --period: 1s;\n /* Customizable */\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  height: var(--inner-height);\n  width: calc(var(--inner-height) * var(--ratio) * var(--icon-count));\n}\n\n.loader .icon {\n  width: calc(100% / var(--icon-count));\n  height: calc(100% * var(--ratio));\n  animation: loader-bounce02 var(--period) infinite linear;\n}\n\n/*\n * animation delay = (n - 1) / steps * period\n */\n\n.loader .icon:nth-of-type(2) {\n  animation-delay: calc(1 / 5 * var(--period));\n}\n\n.loader .icon:nth-of-type(3) {\n  animation-delay: calc(2 / 5 * var(--period));\n}\n\n@keyframes loader-bounce02 {\n  20% {\n    /* Raise */\n    transform: translateY(calc(-50% * (1 - var(--ratio))));\n  }\n\n  40% {\n    /* Lower */\n    transform: translateY(calc(50% * (1 - var(--ratio))));\n  }\n\n  60% {\n    /* Keep centered */\n    transform: translateY(0);\n  }\n\n  80% {\n    /* Keep centered */\n    transform: translateY(0);\n  }\n}\n",
 "combined": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Cuddly Falcon 18</title>\n<style>\n/* From Uiverse.io by DarrylNoakes - https://uiverse.io/DarrylNoakes/cuddly-falcon-18 */\n/* From Uiverse.io by DarrylNoakes - Tags: loader */\n.loader {\n  --icon-count: 3;\n  --inner-height: 4em;\n  --ratio: 2/3;\n /* Customizable */\n  --period: 1s;\n /* Customizable */\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  height: var(--inner-height);\n  width: calc(var(--inner-height) * var(--ratio) * var(--icon-count));\n}\n\n.loader .icon {\n  width: calc(100% / var(--icon-count));\n  height: calc(100% * var(--ratio));\n  animation: loader-bounce02 var(--period) infinite linear;\n}\n\n/*\n * animation delay = (n - 1) / steps * period\n */\n\n.loader .icon:nth-of-type(2) {\n  animation-delay: calc(1 / 5 * var(--period));\n}\n\n.loader .icon:nth-of-type(3) {\n  animation-delay: calc(2 / 5 * var(--period));\n}\n\n@keyframes loader-bounce02 {\n  20% {\n    /* Raise */\n    transform: translateY(calc(-50% * (1 - var(--ratio))));\n  }\n\n  40% {\n    /* Lower */\n    transform: translateY(calc(50% * (1 - var(--ratio))));\n  }\n\n  60% {\n    /* Keep centered */\n    transform: translateY(0);\n  }\n\n  80% {\n    /* Keep centered */\n    transform: translateY(0);\n  }\n}\n</style>\n</head>\n<body>\n<div class=\"loader\">\n    <span class=\"icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" version=\"1.1\" x=\"0\" y=\"0\" viewBox=\"0 0 100 100\">\n            <ellipse transform=\"rotate(-21.283 49.994 75.642)\" cx=\"50\" cy=\"75.651\" rx=\"19.347\" ry=\"16.432\" fill=\"currentColor\"></ellipse>\n            <path fill=\"currentColor\" d=\"M58.474 7.5h10.258v63.568H58.474z\"></path>\n        </svg>\n    </span>\n    <span class=\"icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" version=\"1.1\" x=\"0\" y=\"0\" viewBox=\"0 0 100 100\">\n            <ellipse transform=\"rotate(-21.283 49.994 75.642)\" cx=\"50\" cy=\"75.651\" rx=\"19.347\" ry=\"16.432\" fill=\"currentColor\"></ellipse>\n            <path fill=\"currentColor\" d=\"M58.474 7.5h10.258v63.568H58.474z\"></path>\n        </svg>\n    </span>\n    <span class=\"icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" version=\"1.1\" x=\"0\" y=\"0\" viewBox=\"0 0 100 100\">\n            <ellipse transform=\"rotate(-21.283 49.994 75.642)\" cx=\"50\" cy=\"75.651\" rx=\"19.347\" ry=\"16.432\" fill=\"currentColor\"></ellipse>\n            <path fill=\"currentColor\" d=\"M58.474 7.5h10.258v63.568H58.474z\"></path>\n        </svg>\n    </span>\n</div>\n</body>\n</html>\n"
