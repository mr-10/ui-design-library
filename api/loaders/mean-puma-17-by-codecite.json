 "html": "<div class=\"spinner-container\">\n  <div class=\"spinner\">\n   <div class=\"spinner\">\n    <div class=\"spinner\">\n      <div class=\"spinner\">\n        <div class=\"spinner\">\n            <div class=\"spinner\"></div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>",
 "css": "/* From Uiverse.io by Codecite - Tags: animation, loading, loader, animated */\n.spinner-container {\n  width: 150px;\n  height: 150px;\n  position: relative;\n  margin: 30px auto;\n  overflow: hidden;\n}\n\n.spinner {\n  position: absolute;\n  width: calc(100% - 9.9px);\n  height: calc(100% - 9.9px);\n  border: 5px solid transparent;\n  border-radius: 50%;\n  border-top-color: #fff;\n  animation: spin 5s cubic-bezier(0.17, 0.49, 0.96, 0.79) infinite;\n}\n\n@keyframes spin {\n  from {\n    transform: rotate(0deg);\n  }\n\n  to {\n    transform: rotate(360deg);\n  }\n}\n",
