 "css": "/* Rude Moth 53 by TemRevil — https://uiverse.io/TemRevil/rude-moth-53 */\n.loading-box {\n  width: 150px;\n  height: 150px;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  gap: 10px;\n}\n\n.WH {\n  width: 20px;\n  height: 70px;\n}\n.color {\n  background-color: #ff5100;\n}\n.animation {\n  animation: Loading 1s infinite cubic-bezier(0.68, -0.55, 0.27, 1.55);\n}\n\n@keyframes Loading {\n  0% {\n    height: 0;\n  }\n  25% {\n    height: 70px;\n  }\n  50% {\n    height: 70px;\n    transform: rotate(10deg);\n  }\n  75% {\n    height: 70px;\n    transform: rotate(0deg);\n  }\n  100% {\n    height: 0;\n  }\n}\n",
 "combined": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Rude Moth 53</title>\n<style>\n/* Rude Moth 53 by TemRevil — https://uiverse.io/TemRevil/rude-moth-53 */\n.loading-box {\n  width: 150px;\n  height: 150px;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  gap: 10px;\n}\n\n.WH {\n  width: 20px;\n  height: 70px;\n}\n.color {\n  background-color: #ff5100;\n}\n.animation {\n  animation: Loading 1s infinite cubic-bezier(0.68, -0.55, 0.27, 1.55);\n}\n\n@keyframes Loading {\n  0% {\n    height: 0;\n  }\n  25% {\n    height: 70px;\n  }\n  50% {\n    height: 70px;\n    transform: rotate(10deg);\n  }\n  75% {\n    height: 70px;\n    transform: rotate(0deg);\n  }\n  100% {\n    height: 0;\n  }\n}\n</style>\n</head>\n<body>\n<div class=\"loading-box\">\n  <div class=\"WH animation color\"></div>\n  <div class=\"WH animation color\"></div>\n  <div class=\"WH animation color\"></div>\n</div>\n\n</body>\n</html>\n"
