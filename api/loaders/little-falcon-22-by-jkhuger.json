 "css": "/* Little Falcon 22 by JkHuger — https://uiverse.io/JkHuger/little-falcon-22 */\n.loader-pulse {\n  width: 64px;\n  height: 64px;\n  border-radius: 50%;\n  background: #8f44fd;\n  animation: load-pulse 0.85s infinite linear;\n}\n\n@keyframes load-pulse {\n  0% {\n    transform: scale(0.15);\n    opacity: 0;\n  }\n\n  50% {\n    opacity: 1;\n  }\n\n  100% {\n    transform: scale(1);\n    opacity: 0;\n  }\n}\n",
 "combined": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Little Falcon 22</title>\n<style>\n/* Little Falcon 22 by JkHuger — https://uiverse.io/JkHuger/little-falcon-22 */\n.loader-pulse {\n  width: 64px;\n  height: 64px;\n  border-radius: 50%;\n  background: #8f44fd;\n  animation: load-pulse 0.85s infinite linear;\n}\n\n@keyframes load-pulse {\n  0% {\n    transform: scale(0.15);\n    opacity: 0;\n  }\n\n  50% {\n    opacity: 1;\n  }\n\n  100% {\n    transform: scale(1);\n    opacity: 0;\n  }\n}\n</style>\n</head>\n<body>\n<div class=\"item\">\n    <div class=\"loader-pulse\"></div>\n</div>\n\n</body>\n</html>\n"
